# Public site URL used for canonical links, the sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and publishable key. Required for inquiries, admin auth, and database content.
# Without these, public pages render the included concept content and the inquiry form
# reports that the database is not connected. It will not pretend to save a message.
# Use the publishable key only. Never put a secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://dfimbefcacdmrlhhmyoa.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_UpnNcZLyo9ZdrcjuO5ToiQ_4rCypGvG

# Optional and unused. Admin actions run as the signed-in admin under Row Level Security.
# SUPABASE_SECRET_KEY=

# Direct email notifications for inquiries (via https://resend.com - free)
RESEND_API_KEY=
NOTIFICATION_EMAIL=siddusidharth613@gmail.com
# Optional webhook for instant phone alerts (Discord / Telegram / Slack)
# NOTIFICATION_WEBHOOK_URL=
